# Copy the NAMES below into Streamlit Community Cloud: App settings > Secrets (TOML format).
# For local runs, copy this file to .streamlit/secrets.toml (git-ignored) and fill in the values.
APP_PASSCODE = ""          # required: the passcode people type to open the app
RENTCAST_API_KEY = ""      # optional: RentCast free plan key (50 lookups/month)
RENTCAST_MONTHLY_CAP = "45"      # optional: stop calling RentCast at this many lookups
RENTCAST_USED_OFFSET = ""        # optional: "YYYY-MM:N" lookups already used elsewhere this month
BELLAZU_EXAMPLE = ""             # optional: example home for the "Try an example home" button. A plain address, or JSON like
# '{"address": "...", "price": 250000, "hoa": 600, "beds": 2, "type": "condo", "includes": ["heat/hot water"], "board_multiple": 0}'
